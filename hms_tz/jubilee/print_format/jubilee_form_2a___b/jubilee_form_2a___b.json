 "font": "Default",
 "font_size": 0,
 "html": "<meta name=\"pdfkit-orientation\" content=\"Landscape\">\n<table style=\"width: 100%;\">\n    <tr>\n        <td style=\"width: 20%\">\n            <img src=\"/files/NHIF_logo.png\">\n        </td>\n        <td style=\"width: 60%; text-align: center\">\n            <h5>\n                <b>CONFIDENTIAL</b><br>\n                <b>THE JUBILEE - HEALTH PROVIDER IN/OUT PATIENT CLAIM FORM</b>\n            </h5>\n        </td><td style=\"width: 20%; text-align: left; font-size: 12px;\">\n            Appendix X<br>\n            Form JUBILEE 2A & B<br>\n            Regulation 18(1)<br>\n            AuthorizationNo <b>{{ doc.authorization_no }}</b><br>\n            Serial No: <br><b>{{ doc.folio_no }}</b>\n        </td>\n    </tr>\n</table>\n<br>\n<table style=\"width: 100%\">\n    <tr>\n        <td style=\"text-align: left; font-size: 16px;\">\n            <b>A: PARTICULARS</b>\n        </td>\n    </tr>\n    <tr>\n        <td style=\"width: 46%; text-align: left; font-size: 12px;\">\n            <div class=\"col-xs-15 column-break\">\n                <div class=\"row\">\n                    <div class=\"col-xs-5 text-left\">\n                      <label>Healthcare Facility:</label>\n                    </div>\n                    <div class=\"col-xs-0  value\">\n                       {{ doc.company }} \n                    </div>\n                </div>\n                <div class=\"row\">\n                    <div class=\"col-xs-5 text-left\">\n                      <label>Patient Name:</label>\n                    </div>\n                    <div class=\"col-xs-0  value\">\n                     {{doc.patient_name }}\n                    </div>\n                </div>\n                <div class=\"row\">\n                    <div class=\"col-xs-5 text-left\">\n                      <label>Date of Birth:</label>\n                    </div>\n                    <div class=\"col-xs-0  value\">\n                        {{ doc.date_of_birth }}\n                    </div>\n                </div>\n                <div class=\"row\">\n                    <div class=\"col-xs-5 text-left\">\n                      <label>Sex:</label>\n                    </div>\n                    <div class=\"col-xs-0  value\">\n                       {{ doc.gender }} \n                    </div>\n                </div>\n                <div class=\"row\">\n                    <div class=\"col-xs-5 text-left\">\n                      <label>Occupancy:</label>\n                    </div>\n                    <div class=\"col-xs-0  value\">\n                       \n                    </div>\n                </div>\n                <div class=\"row\">\n                    <div class=\"col-xs-5 text-left\">\n                      <label>Patient Address:</label>\n                    </div>\n                    <div class=\"col-xs-0  value\">\n                        {### {{frappe.db.get_value(\"Patient\", doc.patient, \"area\")}} ####}\n                    </div>\n                </div>\n                <div class=\"row\">\n                    <div class=\"col-xs-5 text-left\">\n                      <label>Vote:</label>\n                    </div>\n                    <div class=\"col-xs-0  value\">\n                        \n                    </div>\n                </div>\n            </div>\n        </td>\n        <td style=\"width: 7%; text-align: left; font-size: 12px;\">\n        </td>\n        <td style=\"width: 47%; text-align: left; font-size: 12px;\">\n            <div class=\"col-xs-15 column-break\">\n                <div class=\"row\">\n                    <div class=\"col-xs-5 text-left\">\n                      <label>Address:</label>\n                    </div>\n                    <div class=\"col-xs-0  value\">\n                        <!--Chusi Street, P.O.BOX 581 Ilala.-->\n                        {% set add_details = frappe.db.get_value(\"Company\", doc.company, [\"p_o_box\", \"street\"]) %}\n                        {{ add_details[0] }} {{add_details[1]}}\n                    </div>\n                </div>\n                <div class=\"row\">\n                    <div class=\"col-xs-5 text-left\">\n                      <label>Card No:</label>\n                    </div>\n                    <div class=\"col-xs-0  value\">\n                       {{ doc.cardno }}\n                    </div>\n                </div>\n                <div class=\"row\">\n                    <div class=\"col-xs-5 text-left\">\n                      <label>Attendance Date:</label>\n                    </div>\n                    <div class=\"col-xs-0  value\">\n                        {{doc.attendance_date}}\n                    </div>\n                </div>\n                <div class=\"row\">\n                    <div class=\"col-xs-5 text-left\">\n                      <label>Patient Type Code:</label>\n                    </div>\n                    <div class=\"col-xs-0  value\">\n                        {{ doc.patient_type_code }}\n                    </div>\n                </div>\n                <div class=\"row\">\n                    <div class=\"col-xs-5 text-left\">\n                      <label>Med. Department:</label>\n                    </div>\n                    <div class=\"col-xs-0  value\">\n                     {{ frappe.db.get_value(\"Healthcare Practitioner\", {\"practitioner_name\": doc.practitioner_name}, \"department\") }}\n                    </div>\n                </div>\n                <div class=\"row\">\n                    <div class=\"col-xs-5 text-left\">\n                      <label>Patient File No:</label>\n                    </div>\n                    <div class=\"col-xs-0  value\">\n                       {{ doc.patient }}\n                    </div>\n                </div>\n                <div class=\"row\">\n                    <div class=\"col-xs-5 text-left\">\n                      <label>Authorization No:</label>\n                    </div>\n                    <div class=\"col-xs-0  value\">\n                       {{ doc.authorization_no }}\n                    </div>\n                </div>\n            </div>\n        </td>\n    </tr>\n</table>\n<hr>\n\n<p style=\"text-align: left; font-size: 14px;\">\n    <b>Diagnosis Code</b>\n</p>\n<table style=\"width: 100%;\">\n    <tr>\n        <td style=\"width: 49%;\">\n            <b>Provisional Diagnosis</b>\n           <table border=1 style=\"width: 100%; border-collapse: collapse; border: 1px solid black; margin-bottom: 10px;\">\n                <thead style=\"background-color: #D3D3D3;\">\n                    <tr>\n                        <td style=\"text-align: center;\">Disease Code</td>\n                        <td style=\"text-align: center;\">Description</td>\n                    </tr>\n                </thead>\n                {% for item in doc.jubilee_patient_claim_disease %}\n                     {% if item.status == \"Provisional\" %}\n                     <tr>\n                         <td style=\"text-align: left;\">{{item.disease_code }}</td>\n                         <td style=\"text-align: left;\">{{item.description }}</td>\n                     </tr>\n                    {% endif %}\n                {% endfor %}\n            </table> \n        </td>\n        <td style=\"width: 2%;\"></td>\n        <td style=\"width: 49%;\">\n            <b>Final Diagnosis</b>\n            <table border=1 style=\"width: 100%; border: 1px solid black; margin-bottom: 10px;\">\n                <thead style=\"background-color: #D3D3D3;\">\n                    <tr>\n                        <td style=\"text-align: center;\">Disease Code</td>\n                        <td style=\"text-align: center;\">Description</td>\n                    </tr>\n                </thead>\n                {% for item in doc.jubilee_patient_claim_disease %}\n                    {% if item.status == \"Final\" %}\n                        <tr>\n                            <td style=\"text-align: left;\">{{item.disease_code }}</td>\n                            <td style=\"text-align: left;\">{{item.description }}</td>\n                        </tr>\n                    {% endif %}\n                {% endfor %}\n            </table>\n        </td>\n    </tr>\n</table>\n<hr>\n\n<p style=\"text-align: left; font-size: 16px;\">\n    <b>B: Details / Cost of services</b>\n</p>\n<table border=1 style=\"width: 100%; border-collapse: collapse; border: 1px solid black; \">\n    <COLGROUP>\n        <COL WIDTH=\"2%\">\n        <COL WIDTH=\"15%\">\n        <COL WIDTH=\"35%\">\n        <COL WIDTH=\"8%\">\n        <COL WIDTH=\"6%\">\n        <COL WIDTH=\"16%\">\n        <COL WIDTH=\"29%\">\n    </COLGROUP>\n    <thead style=\"background-color: #D3D3D3;\">\n        <tr>\n            <td style=\"text-align: center;\">Sr</td>\n            <td style=\"text-align: center;\">Ref DocType</td>\n            <td style=\"text-align: center;\">Item Name</td>\n            <td style=\"text-align: center;\">Item Code</td>\n            <td style=\"text-align: center;\">Item Quantity</td>\n            <td style=\"text-align: center;\">Unit Price</td>\n            <td style=\"text-align: center;\">Amount</td>\n        </tr>\n    </thead>\n    <tbody>\n           \n        {% set total = [0] %}\n        {% for item in doc.jubilee_patient_claim_item %}\n           {% set total = total.append(total.pop() + item.amount_claimed) %}\n         \n            <tr>\n                <td style=\"text-align: center;\">{{ loop.index }}</td>\n                <td style=\"text-align: left;\">{{ item.ref_doctype | replace(\" Prescription\",\":\") }}</td>\n                <td style=\"text-align: left;\">\n                    {% if  item.ref_doctype == \"Drug Prescription\" %}\n                        {% set drug = frappe.db.get_all(\"Drug Prescription\", \n                        {\"parent\": item.patient_encounter, \"name\": item.ref_docname, \"drug_code\":item.item_name, \"drug_name\": item.item_name},\n                        [\"dosage\", \"period\", \"dosage_form\"])  %}\n                        \n                        {{item.item_name}},\n                        {% if drug %}\n                            {% if drug[0][\"dosage\"] %} Dosage: {{ drug[0][\"dosage\"] }}, {% endif %}\n                            {% if drug[0][\"period\"] %} Period: {{ drug[0][\"period\"] }}, {% endif %}\n                            {% if drug[0][\"dosage_form\"] %} Form: {{ drug[0][\"dosage_form\"] }} {% endif %}\n                         {% endif %}\n\n                    {% else %}\n                        {{item.item_name}}\n                        \n                    {% endif %}\n                    {% if item.approval_ref_no %} {{ item.approval_ref_no }} {% endif %}\n                </td>\n                <td style=\"text-align: left;\">{{item.item_code }}</td>\n                <td style=\"text-align: center;\">{{item.item_quantity }}</td>\n                <td style=\"text-align: right;\">{{ frappe.utils.fmt_money(item.unit_price, currency=\"TZS\", precision=2) }}</td>\n                <td style=\"text-align: right;\">{{ frappe.utils.fmt_money(item.amount_claimed, currency='TZS', precision = 2) }}</td>\n            </tr>\n        {% endfor %}\n        <tr>\n            <td colspan=\"6\"><b>Total</b></td>\n            <td  style=\"text-align: right;\"> {{ frappe.utils.fmt_money(total[0], currency=\"TZS\", precision = 2) }}   </td>\n        </tr>\n    </tbody>\n        \n</table>\n<hr>\n\n<p style=\"text-align: left; font-size: 16px;\">\n    <b>C: Clinician Information</b>\n</p>\n<table style=\"width: 100%;\">\n    <tr>\n        <td style=\"width: 50%; text-align: left; font-size: 12px;\">\n            <div class=\"row  data-field\" data-fieldname=\"company\" data-fieldtype=\"Link\">\n                <div class=\"col-xs-5\">\n                    <label>Name of attending Clinician</label>\n            \t</div>\n            \t<div class=\"col-xs-7 text-left value\">\n            \t\t{{ doc.practitioner_name  }}\n            \t</div>\n            </div>\n                \n            <div class=\"row  data-field\" data-fieldname=\"company\" data-fieldtype=\"Link\">\n                <div class=\"col-xs-5\">\n                    <label>MCT Reg. No</label>\n            \t</div>\n            \t<div class=\"col-xs-7 text-left value\">\n            \t\t{{ frappe.db.get_value(\n                        \"Healthcare Practitioner\", \n                        {\"practitioner_name\": doc.practitioner_name},\n                        \"tz_mct_code\")\n            \t\t}}\n            \t</div>\n            </div>\n            \n            <div class=\"row  data-field\" data-fieldname=\"company\" data-fieldtype=\"Link\">\n                <div class=\"col-xs-5\">\n                    <label>Qualification</label>\n            \t</div>\n            \t<div class=\"col-xs-7 text-left value\">\n            \t\t{{ frappe.db.get_value(\n                            \"NHIF Physician Qualification\",\n                            frappe.db.get_value(\n                                \"Healthcare Practitioner\", \n                                {\"practitioner_name\": doc.practitioner_name}, \n                                \"nhif_physician_qualification\"),\n                            \"qualification\")\n            \t\t}}\n            \t</div>\n            </div>\n            \n            <div class=\"row  data-field\" data-fieldname=\"company\" data-fieldtype=\"Link\">\n                <div class=\"col-xs-5\">\n                    <label>Mobile No:</label>\n            \t</div>\n            \t<div class=\"col-xs-7 text-left value\">\n            \t\t{{ frappe.db.get_value(\n                        \"Healthcare Practitioner\", \n                        {\"practitioner_name\": doc.practitioner_name}, \n                        \"mobile_phone\")\n            \t\t}}\n            \t</div>\n            </div>\n        </td>\n        <td style=\"width: 50%; text-align: left; font-size: 12px;\">\n            {% set signature = frappe.db.get_value( \n                \"Healthcare Practitioner\", \n                {\"practitioner_name\": doc.practitioner_name}, \n                \"doctors_signature\") \n            %}\n            {% if not signature %}\n                {% set signature = frappe.db.get_value( \"Healthcare Practitioner\", \"Direct Cash\", \"doctors_signature\") %}\n            {% endif %}\n            <div class=\"row  data-field\" data-fieldname=\"company\" data-fieldtype=\"Link\">\n                <div class=\"row\">\n                    <div class=\"col-xs-5\">\n                        <label>Signature</label>\n                    </div>\n                    <div class=\"col-xs-7 text-left value\">\n                \t    <img src=\"{{ signature }}\">\n                \t</div>\n            \t</div>\n            </div>\n        </td>\n    </tr>\n</table>\n<hr>\n\n<p style=\"text-align: left; font-size: 16px;\">\n    <b>D: Patient Certification:</b>\n</p>\n<table style=\"width: 100%;\">\n    <tr>\n        <td style=\"width: 50%; text-align: left; font-size: 12px;\">\n            I certify that I received the above named services.\n            \n            <div class=\"row  data-field\" data-fieldname=\"company\" data-fieldtype=\"Link\">\n                <div class=\"col-xs-5\">\n                    <label>Patient Name:</label>\n            \t</div>\n            \t<div class=\"col-xs-7 text-left value\">\n            \t\t{{ doc.patient_name\t}}\n            \t</div>\n            </div>\n            <div class=\"row  data-field\" data-fieldname=\"company\" data-fieldtype=\"Link\">\n                <div class=\"col-xs-5\">\n                    <label>Telephone No:</label>\n                </div>\n                <div class=\"col-xs-7 text-left value\">\n            \t    {{doc.telephone_no }}\n            \t</div>\n            </div>\n        </td>\n        <td style=\"width: 50%; text-align: left; font-size: 12px;\">\n            <div class=\"row  data-field\" data-fieldname=\"company\" data-fieldtype=\"Link\">\n                <div class=\"col-xs-5\">\n                    <label>Patient Signature:</label>\n            \t</div>\n            \t<div class=\"col-xs-0 text-left value\">\n            \t\t<img src = \"{{doc.patient_signature}}\"  width=\"300\" height=\"100\">\n            \t</div>\n            </div>\n        </td>\n    </tr>\n</table>\n<hr>\n\n<p style=\"text-align: left; font-size: 16px;\">\n    <b>E: Description of In/Out-patient Management / any other information</b>\n</p>\n<p style=\"text-align: center; font-size: 14px;\">\n    <b>Date of Attendance: </b> {{doc.attendance_date}}\n</p>\n\n<p style=\"text-align: left; font-size: 13px;\">\n    <b>Clinical Notes</b>\n</p>\n<p style=\"text-align: left; font-size: 12px;\">\n    {{ doc.clinical_notes }}\n</p>\n<hr>\n\n<p style=\"text-align: left; font-size: 16px;\">\n    <b>F: Claimant Certification:</b>\n</p>\n<table style=\"width: 100%;\">\n    <tr>\n        <td style=\"text-align: left; font-size: 12px; width: 50%\">\n            I certify that I provided the above named services\n            \n            <div class=\"row  data-field\" data-fieldname=\"company\" data-fieldtype=\"Link\">\n                <div class=\"col-xs-3\">\n                    <label>Name:</label>\n            \t</div>\n            \t<div class=\"col-xs-7 text-left value\">\n            \t    {% set practitioner = frappe.db.get_value( \"Healthcare Practitioner\", {\"user_id\": doc.modified_by}, \"name\") %}\n            \t    {% if not practitioner %}\n            \t        {% set practitioner = frappe.db.get_value( \"Healthcare Practitioner\", {\"user_id\": frappe.session.user}, \"name\") %}\n            \t    {% endif %}\n            \t    {{ practitioner }}\n            \t</div>\n            </div> \n            <img src=\"/files/SHM-hospitals.png\" style=\"width: 50px !important;\">\n            {% if doc.company == \"Shree Hindu Mandal Hospital - Dar es Salaam\" %}\n                <img src=\"/files/SHM DSM Insurance Dept Stamp 2021-10-13_16-08-41.jpg\" style=\"width: 150px !important;\">\n            {% elif doc.company == \"Shree Hindu Mandal Super Specialized Polyclinic - Kunduchi\" %}\n                <img src=\"/files/shmssp kunduchi img.jpg\" style=\"width: 150px !important;\">\n            {% endif %}\n        </td>\n        <td style=\"text-align: left; font-size: 12px; width: 50%\">\n            <br>\n            <div class=\"row  data-field\" data-fieldname=\"company\" data-fieldtype=\"Link\">\n                <div class=\"col-xs-5\">\n                    <label>Claimant Signature</label>\n                </div>\n                <div class=\"col-xs-7 text-left value\">\n                    {% set signature = frappe.db.get_value(\"Healthcare Practitioner\", {\"user_id\": doc.modified_by}, \"doctors_signature\") %}\n                    {% if not signature %}\n                        {% set signature = frappe.db.get_value( \"Healthcare Practitioner\", {\"user_id\": frappe.session.user}, \"doctors_signature\") %}\n                    {% endif %}\n                    {% if not signature %}\n                        {% set signature = frappe.db.get_value( \"Healthcare Practitioner\", \"Direct Cash\", \"doctors_signature\") %}\n                    {% endif %}\n                    \n            \t    <img src=\"{{ signature }}\">\n            \t</div>\n            </div>\n        </td>\n    </tr>\n</table>\n<hr>\n\n<p style=\"text-align: left; font-size: 14px;\">\n    <b>NOTE:</b>\n</p>\n<p style=\"font-size: small;\">\n    Patient should sign the form after completion of service<br>\n    Before referring patient to other facility, referring facility should be satisfied for the missing item and its alternative within\nthe facility.<br>\nAny falsified information may subject you to prosecution in accordance with Jubilee Act No. 8 of 1999.\n</p>\n\n\n",
